local function addColorPicker(parentPage, titleText, currentColor, callback)
    local card = createCard(parentPage, 115)

    local title = Instance.new("TextLabel", card)
    title.Size = UDim2.new(1, -20, 0, 22)
    title.Position = UDim2.new(0, 12, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = "🌸 " .. titleText .. " ♡"
    title.TextColor3 = SOFT_TEXT
    title.Font = Enum.Font.FredokaOne
    title.TextSize = 13
    title.TextXAlignment = Enum.TextXAlignment.Left

    local colors = {
        {"Red", Color3.fromRGB(255, 90, 110)},
        {"Orange", Color3.fromRGB(255, 155, 70)},
        {"Yellow", Color3.fromRGB(255, 225, 90)},
        {"Lime", Color3.fromRGB(175, 235, 90)},
        {"Green", Color3.fromRGB(95, 210, 125)},
        {"Mint", Color3.fromRGB(110, 235, 195)},
        {"Cyan", Color3.fromRGB(90, 220, 235)},
        {"Sky", Color3.fromRGB(100, 175, 255)},
        {"Blue", Color3.fromRGB(80, 120, 255)},
        {"Navy", Color3.fromRGB(55, 65, 170)},
        {"Purple", Color3.fromRGB(155, 100, 240)},
        {"Violet", Color3.fromRGB(205, 100, 245)},
        {"Pink", Color3.fromRGB(255, 105, 180)},
        {"Rose", Color3.fromRGB(255, 125, 155)},
        {"Peach", Color3.fromRGB(255, 175, 145)},
        {"White", Color3.fromRGB(255, 255, 255)},
        {"Gray", Color3.fromRGB(170, 175, 190)},
        {"Black", Color3.fromRGB(35, 30, 45)}
    }

    local swatches = {}
    local selectedIndex = 13

    for i, data in ipairs(colors) do
        local name, color = data[1], data[2]
        local row = math.floor((i - 1) / 9)
        local col = (i - 1) % 9

        local btn = Instance.new("TextButton", card)
        btn.Name = name .. "Swatch"
        btn.Size = UDim2.new(0, 26, 0, 26)
        btn.Position = UDim2.new(0, 12 + (col * 38), 0, 34 + (row * 34))
        btn.BackgroundColor3 = color
        btn.Text = ""
        btn.AutoButtonColor = false
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        local stroke = Instance.new("UIStroke", btn)
        stroke.Color = Color3.fromRGB(240, 180, 220)
        stroke.Thickness = 1
        swatches[i] = stroke

        if math.abs(currentColor.R - color.R) < 0.001
            and math.abs(currentColor.G - color.G) < 0.001
            and math.abs(currentColor.B - color.B) < 0.001 then
            selectedIndex = i
        end

        btn.MouseButton1Click:Connect(function()
            callback(color)
            for j, s in ipairs(swatches) do
                s.Color = (j == i) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(240, 180, 220)
                s.Thickness = (j == i) and 2 or 1
            end
        end)
    end

    for i, s in ipairs(swatches) do
        s.Color = (i == selectedIndex) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(240, 180, 220)
        s.Thickness = (i == selectedIndex) and 2 or 1
    end
end

