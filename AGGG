    if gpe then return end
    
    -- Silent Aim Toggle Keybind (V)
    if cfg.useKeybind and i.KeyCode == cfg.silentAimKey then
        cfg.silentAim = not cfg.silentAim
    end
    
    -- Speed Boost Toggle Keybind (X)
    if i.KeyCode == cfg.speedKey and cfg.speedHackMaster then
        cfg.speedBoostActive = not cfg.speedBoostActive
    end

    -- Jump Power Toggle Keybind (C)
    if i.KeyCode == cfg.jumpKey and cfg.jumpPowerMaster then
        cfg.jumpPowerActive = not cfg.jumpPowerActive
    end
    
    -- UI Menu Toggle Keybind (RightControl)
    if i.KeyCode == cfg.uiToggleKey then
        ScreenGui.Enabled = not ScreenGui.Enabled
    end
end)
