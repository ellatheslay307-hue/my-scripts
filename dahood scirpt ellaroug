local function createSlider(name, min, max, step, initialVal, callback)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 50)
    container.BackgroundTransparency = 1
    container.Parent = content
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 0, 25)
    label.Position = UDim2.new(0, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.new(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Parent = container
    
    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.5, 0, 0, 25)
    valueLabel.Position = UDim2.new(0.5, 0, 0, 0)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(initialVal)
    valueLabel.TextColor3 = Color3.new(0, 0, 0)
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextSize = 14
    valueLabel.Parent = container
    
    local sliderBg = Instance.new("Frame")
    sliderBg.Size = UDim2.new(1, 0, 0, 10)
    sliderBg.Position = UDim2.new(0, 0, 0, 28)
    sliderBg.BackgroundColor3 = Color3.fromRGB(255, 130, 180)
    sliderBg.BorderSizePixel = 0
    sliderBg.Parent = container
    
    local sc = Instance.new("UICorner")
    sc.CornerRadius = UDim.new(0, 5)
    sc.Parent = sliderBg
    
    local sliderFill = Instance.new("Frame")
    sliderFill.Name = "Fill"
    sliderFill.Size = UDim2.new((initialVal - min) / (max - min), 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderBg
    
    local sf = Instance.new("UICorner")
    sf.CornerRadius = UDim.new(0, 5)
    sf.Parent = sliderFill
    
    -- Invisible slider handle area
    local sliderArea = Instance.new("TextButton")
    sliderArea.Size = UDim2.new(1, 0, 0, 20)
    sliderArea.Position = UDim2.new(0, 0, 0, 23)
    sliderArea.BackgroundTransparency = 1
    sliderArea.Text = ""
    sliderArea.Parent = container
    
    local dragging = false
    local sliderValue = initialVal
    
    local function updateSlider(pos)
        if not dragging then return end
        local relX = (pos.X - sliderArea.AbsolutePosition.X) / sliderArea.AbsoluteSize.X
        relX = math.clamp(relX, 0, 1)
        sliderValue = min + relX * (max - min)
        sliderValue = math.floor(sliderValue / step) * step
        sliderValue = math.clamp(sliderValue, min, max)
        sliderFill.Size = UDim2.new((sliderValue - min) / (max - min), 0, 1, 0)
        valueLabel.Text = tostring(sliderValue)
        if callback then callback(sliderValue) end
    end
    
    sliderArea.MouseButton1Down:Connect(function()
        dragging = true
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
            updateSlider(input.Position)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    return container
end

