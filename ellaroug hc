-- Speed Boost Enforcement Loop
RunService.Stepped:Connect(function()
    local char = lp.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if cfg.speedBoostEnabled then
            if hum then
                hum.WalkSpeed = cfg.speedValue
            end
            if hum and hrp and hum.MoveDirection.Magnitude > 0 then
                hrp.AssemblyLinearVelocity = Vector3.new(
                    hum.MoveDirection.X * cfg.speedValue,
                    hrp.AssemblyLinearVelocity.Y,
                    hum.MoveDirection.Z * cfg.speedValue
                )
            end
        else
            -- Reset walkspeed back to normal when disabled
            if hum and hum.WalkSpeed ~= cfg.defaultSpeed then
                hum.WalkSpeed = cfg.defaultSpeed
            end
        end
    end
end)

-- Safe custom atmosphere handling
local function getOrCreateFogAtmosphere()
    local at = Lighting:FindFirstChild("EllarougFog")
    if not at then
        at = Instance.new("Atmosphere")
        at.Name = "EllarougFog"
        at.Parent = Lighting
    end
    return at
end

local function removeFogAtmosphere()
    local at = Lighting:FindFirstChild("EllarougFog")
    if at then
        at:Destroy()
    end
end

-- Render loop
RunService.PreRender:Connect(function()
    if cfg.fogEnabled then
        local fogAtmosphere = getOrCreateFogAtmosphere()
        
        for _, child in ipairs(Lighting:GetChildren()) do
            if child:IsA("Atmosphere") and child ~= fogAtmosphere then
                child.Density = 0
                child.Haze = 0
            end
        end

        Lighting.FogColor = cfg.fogColor
        Lighting.FogStart = math.max(0, cfg.fogStart)
        Lighting.FogEnd = math.max(cfg.fogStart + 1, cfg.fogEnd)

        fogAtmosphere.Color = cfg.fogColor
        fogAtmosphere.Decay = cfg.fogColor
        fogAtmosphere.Density = math.clamp(1 - ((cfg.fogEnd - cfg.fogStart) / 1000), 0.15, 0.95)
        fogAtmosphere.Haze = 2.5
        fogAtmosphere.Glare = 0
        fogAtmosphere.Offset = math.clamp(cfg.fogStart / 500, 0, 1)
    else
        removeFogAtmosphere()

        Lighting.FogColor = defaultLighting.FogColor
        Lighting.FogStart = defaultLighting.FogStart
        Lighting.FogEnd = defaultLighting.FogEnd

        for at, props in pairs(originalAtmospheres) do
            if at and at.Parent == Lighting then
                at.Density = props.Density
                at.Haze = props.Haze
                at.Glare = props.Glare
                at.Offset = props.Offset
                at.Color = props.Color
                at.Decay = props.Decay
            end
        end
    end
end)

